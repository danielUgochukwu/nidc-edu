# Clerk publishable key used by Clerk client components.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Clerk secret key used by server-side auth helpers.
CLERK_SECRET_KEY=

# Svix signing secret for Clerk webhooks.
CLERK_WEBHOOK_SECRET=

# Public sign-in route used by Clerk.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Public sign-up route used by Clerk.
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Post-login route; proxy redirects this to the role home.
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard

# Post-signup route; proxy redirects this to the role home.
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Runtime PostgreSQL connection string. Use Supabase transaction pooling for serverless deployments.
DATABASE_URL=

# Prisma CLI migration connection string. Use Supabase direct or session-pooler connection, not transaction pooling.
DIRECT_URL=

# Supabase project URL.
SUPABASE_URL=

# Supabase service role key for server-side Storage operations.
SUPABASE_SERVICE_ROLE_KEY=

# Resend API key for transactional email.
RESEND_API_KEY=

# Paystack secret key placeholder; implemented in Phase 8.
PAYSTACK_SECRET_KEY=

# Public application origin used to build invite links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron endpoint shared secret placeholder; implemented in Phase 4.
CRON_SECRET=
